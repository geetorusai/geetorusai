{
  "name": "@geetorusai/adapter-lmstudio-local",
  "version": "0.3.1",
  "license": "MIT",
  "homepage": "https://github.com/geetorusai/geetorus",
  "bugs": {
    "url": "https://github.com/geetorusai/geetorus/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/geetorusai/geetorus",
    "directory": "packages/adapters/lmstudio-local"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./src/ui/index.ts",
      "default": "./src/ui/index.ts"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./src/cli/index.ts",
      "default": "./src/cli/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./ui": {
        "types": "./dist/ui/index.d.ts",
        "import": "./dist/ui/index.js"
      },
      "./cli": {
        "types": "./dist/cli/index.d.ts",
        "import": "./dist/cli/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@geetorusai/adapter-utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
