[Unit]
Description=Geetorus AI Agent Orchestrator
Requires=geetorus-db.service
After=geetorus-db.service

[Container]
Image=geetorus-local
ContainerName=geetorus
Pod=geetorus.pod
Volume=%h/.local/share/geetorus:/geetorus:Z
Environment=HOST=0.0.0.0
Environment=GEETORUS_HOME=/geetorus
Environment=GEETORUS_DEPLOYMENT_MODE=authenticated
Environment=GEETORUS_DEPLOYMENT_EXPOSURE=private
Environment=GEETORUS_PUBLIC_URL=http://localhost:3100
EnvironmentFile=%h/.config/containers/systemd/geetorus.env

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=default.target
