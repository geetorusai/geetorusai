# Geetorus Docker Environment
# Copy this to .env and fill in values before running: docker compose up --build

# ── REQUIRED ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# ── LLM PROVIDERS (at least one needed for agents to run) ───────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=

# ── DEPLOYMENT ───────────────────────────────────────────────────────────────
# authenticated = requires login (recommended for production)
# local_trusted = skips auth (dev only)
GEETORUS_DEPLOYMENT_MODE=authenticated

# Port Geetorus listens on (default: 3100)
GEETORUS_PORT=3100

# Public URL users will access the UI at
GEETORUS_PUBLIC_URL=http://localhost:3100

# Persistent data directory (database, agent workspaces, uploads)
# GEETORUS_DATA_DIR=./data/geetorus
